# Production settings for deploy/compose.yml. Copy to deploy/.env on the VPS and fill in every value.
NODE_ENV=production
PORT=3000

# Database. Use the same password in both lines. Letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://wpfeeder:CHANGE_ME@db:5432/wpfeeder
# Postgres runs next to the app on the same machine, so no SSL.
DATABASE_SSL=false

# Auth0 application > Settings.
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.eu.auth0.com
AUTH0_CLIENT_ID=CHANGE_ME
AUTH0_CLIENT_SECRET=CHANGE_ME

# The address in the browser bar, without a trailing slash.
BASE_URL=https://wpfeeder.yourdomain.example

# openssl rand -base64 32
SESSION_SECRET=CHANGE_ME
# openssl rand -base64 32. Back this up: losing it makes every saved site password unreadable.
ENCRYPTION_KEY=CHANGE_ME
