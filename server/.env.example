# Copy to server/.env (dev) and server/.env.test (tests), then fill in real values.
# .env.test points DATABASE_URL at wpfeeder_test and sets NODE_ENV=test.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/wpfeeder
# Auth0 "Regular Web Application". BASE_URL is the address in the browser bar (Vite in dev).
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.eu.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=GENERATE_ME
BASE_URL=http://localhost:5173
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=GENERATE_ME
